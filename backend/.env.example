# ---------------------------------------------------------------------------
# TrendRadar backend — environment variables
# Copy to .env and adjust.  All variables are optional; defaults are shown.
# ---------------------------------------------------------------------------

# ---- Auto-scan on startup (the "run backend on my laptop for 5 min" flow) --
# When true (default), the server starts a background scan at boot if data is
# missing or older than STALE_SCAN_MAX_AGE_HOURS.
AUTO_SCAN_ON_STARTUP=true
STALE_SCAN_MAX_AGE_HOURS=18

# ---- Scheduler -------------------------------------------------------------
# Daily after-close scan (default 10:15 UTC = 15:45 IST, just after NSE close).
# Set DISABLE_SCHEDULER=1 if you only ever run the backend ad-hoc on a laptop.
SCHEDULER_HOUR_UTC=10
SCHEDULER_MINUTE_UTC=15
# DISABLE_SCHEDULER=0

# ---- Storage ---------------------------------------------------------------
# Override the SQLite path (e.g. a mounted volume on Railway/Render).
# SQLITE_DB_PATH=market_predictor.db

# ---- Static snapshot export (offline frontend) ------------------------------
# After every completed scan the full dataset (leaderboard, stock details,
# charts) is exported as static JSON so the frontend works when the backend
# is down.  Relative paths resolve against the repo root; commit the output.
# STATIC_EXPORT_DIR=frontend/public/data

# ---- CORS ------------------------------------------------------------------
# Extra comma-separated origins allowed to call the API (beyond localhost:3000).
# Useful if you expose the laptop backend via a tunnel (cloudflared / ngrok)
# and want the Vercel frontend to reach it directly.
# CORS_ORIGINS=https://your-frontend.vercel.app,https://xxx.trycloudflare.com
